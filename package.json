{
  "name": "nullion",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:debug": "tsc --noEmit && VITE_DEBUG=1 vite build --outDir dist-debug",
    "preview": "vite preview",
    "test": "vitest run",
    "bank:index": "UPDATE_BANK_INDEX=1 vitest run src/data/bank-index.test.ts",
    "bank:schedule": "UPDATE_SCHEDULE=1 vitest run src/data/schedule.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.2.6",
    "@fontsource/courier-prime": "^5.2.5",
    "@fontsource/silkscreen": "^5.3.0",
    "@fontsource/vt323": "^5.3.0"
  }
}
